# MCP Brasil executado em processo privado via stdio por padrão.
MCP_TRANSPORT=stdio
# HTTP deve apontar ao integration/bridge.py, e não ao servidor padrão sem as extensões.
MCP_URL=http://127.0.0.1:8001/mcp
MCP_TOKEN=
DATABASE_PATH=data/observatorio.sqlite3
REFRESH_HOURS=24
MCP_TIMEOUT_SECONDS=90
# Originações do frontend que podem consultar a API (sem curingas).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opcional: regex restrita ao hostname do projeto Pages para URLs de Preview.
CORS_ORIGIN_REGEX=
# Token de um Cloudflare Tunnel remotamente gerenciado (usar apenas ao ativar o perfil tunnel).
CLOUDFLARED_TUNNEL_TOKEN=
# CNPJ oficial da Prefeitura: obter/validar no cadastro de entes SICONFI ou PNCP.
# Se vazio, a ingestão tenta obter pelo código IBGE no SICONFI.
MUNICIPAL_CNPJ=
# Não criar .env com segredos no repositório.
